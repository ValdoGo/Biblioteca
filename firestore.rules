rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função para verificar se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Função para verificar se o usuário é o próprio dono do documento
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Função para verificar se o usuário possui a role 'admin'
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Coleção de Usuários: Qualquer um pode criar seu próprio perfil ao cadastrar.
    // Usuários podem ler seu próprio perfil, Admins podem ler todos.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Coleção de Livros: Leitores podem consultar todos os livros.
    // Apenas Administradores podem criar, atualizar e excluir livros.
    match /books/{bookId} {
      allow read: if true; // Permite leitura pública ou por leitores autenticados
      allow write, create, update, delete: if isAdmin();
      
      // Avaliações dos livros (Reviews)
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isOwner(resource.data.userId) || isAdmin();
      }
    }

    // Subcoleção de Favoritos e Progresso do Usuário
    match /users/{userId}/favorites/{bookId} {
      allow read, write: if isOwner(userId);
    }
    
    match /users/{userId}/progress/{bookId} {
      allow read, write: if isOwner(userId);
    }
  }
}
